# =============================================================================
# SRE Platform Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit .env to version control.

# --- Application ---
APP_NAME=Engineer Assist
APP_VERSION=3.2.0
APP_ENV=development           # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engineer_assist
DB_ECHO=false
DB_POOL_SIZE=20               # Persistent connections in the pool
DB_MAX_OVERFLOW=10            # Extra connections beyond pool_size

# --- Redis ---
# Used for caching, rate limiting, and task queue
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
# Generate a strong key: openssl rand -hex 64
# MUST be set in production - random generation only works in development
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Values: json (structured), console (human-readable)
LOG_FORMAT=json

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Development Auth ---
# Only used when APP_ENV=development and no Authorization header
# Set to empty string to disable dev fallback
DEV_DEFAULT_USER=

# --- Platform Adapters ---
# vSphere (pyVmomi)
# No additional config needed - credentials stored per platform in DB

# KVM (libvirt)
# Default SSH port for KVM hosts
KVM_DEFAULT_PORT=22

# FusionSphere
# Default API port
FUSIONSPHERE_DEFAULT_PORT=7443
